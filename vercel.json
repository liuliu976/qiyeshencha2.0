{
  "version": 2,
  "builds": [
    {
      "src": "api/review.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/review", "dest": "/api/review.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}